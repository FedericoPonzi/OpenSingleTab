{
  "name": "open-single-tab",
  "displayName": "OpenSingleTab",
  "version": "1.0.2",
  "description": "A browser extension to keep your tabs under control. Free and Open Source.",
  "author": "Federico Ponzi <me@fponzi.me>",
  "scripts": {
    "get-git-hash": "node scripts/get-git-hash.js",
    "dev": "npm run get-git-hash && plasmo dev",
    "build": "npm run get-git-hash && plasmo build",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "test:coverage": "node --test --experimental-test-coverage"
  },
  "dependencies": {
    "plasmo": "^0.90.3",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.4.1",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/chrome": "^0.3.7",
    "@types/react": "^18.2.0",
    "postcss": "^8.4.31",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2"
  },
  "manifest": {
    "permissions": [
      "tabs",
      "storage"
    ],
    "background": {
      "service_worker": "src/background.js"
    },
    "browser_specific_settings": {
      "gecko": {
        "id": "{89c004be-1e2d-469e-83ee-efc29c29785c}"
      }
    }
  }
}
